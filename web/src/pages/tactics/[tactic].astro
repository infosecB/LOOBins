---
// The per-tactic pages were folded into the /binaries/ filters; keep old links working.
import { getCollection } from 'astro:content';
import { filterUrl, loobinTactics, slugify } from '../../utils/helpers';

export async function getStaticPaths() {
  const loobins = await getCollection('loobins');
  const tactics = new Set(loobins.flatMap(loobinTactics));
  return [...tactics].map((tactic) => ({ params: { tactic: slugify(tactic) }, props: { tactic } }));
}

return Astro.redirect(filterUrl('tactic', Astro.props.tactic), 301);
---
