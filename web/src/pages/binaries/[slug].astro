---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UseCaseBlock from '../../components/UseCaseBlock.astro';
import TacticBadge from '../../components/TacticBadge.astro';
import { getCollection } from 'astro:content';
import { formatDate, loobinTactics, slugify, tacticOrder, url } from '../../utils/helpers';

export async function getStaticPaths() {
  const loobins = await getCollection('loobins');
  return loobins.map((loobin) => ({
    params: { slug: loobin.id },
    props: { loobin },
  }));
}

const { loobin } = Astro.props;
const { data } = loobin;

const allTactics = loobinTactics(loobin);

// Stable anchors so detection content can link straight to a technique; suffix repeats.
const seenIds = new Map<string, number>();
const useCases = data.example_use_cases.map((uc) => {
  const base = slugify(uc.name) || 'use-case';
  const n = (seenIds.get(base) ?? 0) + 1;
  seenIds.set(base, n);
  return {
    ...uc,
    id: n === 1 ? base : `${base}-${n}`,
    tactics: tacticOrder.filter((t) => uc.tactics.includes(t)),
  };
});

const tocSections = [
  { id: 'detections', label: 'Detections' },
  ...(data.resources.length > 0 ? [{ id: 'resources', label: 'Resources' }] : []),
  ...(data.acknowledgements.length > 0 ? [{ id: 'acknowledgements', label: 'Acknowledgements' }] : []),
];

const h2 = 'text-lg font-semibold tracking-tight mb-4 scroll-mt-24';
const tocLink = 'block border-l border-border pl-3 py-1 text-text-secondary hover:text-text-primary aria-[current=true]:border-leaf aria-[current=true]:text-text-primary transition-colors';
---

<BaseLayout title={data.name} description={data.short_description} type="article" markdownPath={`/binaries/${loobin.id}.md`}>
  <div class="mb-8">
    <a href={url('/binaries/')} class="text-text-secondary hover:text-text-primary text-sm transition-colors">&larr; All Binaries</a>
  </div>

  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-16">
    <article class="min-w-0">
      <header class="mb-12">
        <h1 class="text-3xl sm:text-4xl font-mono font-semibold tracking-tight mb-4" data-pagefind-meta="title">{data.name}</h1>
        <p class="text-text-secondary text-lg leading-relaxed max-w-3xl mb-5">{data.full_description}</p>

        <div class="flex flex-wrap gap-1.5 mb-8">
          {allTactics.map((t: string) => <TacticBadge tactic={t} />)}
        </div>

        <dl class="grid grid-cols-1 sm:grid-cols-[1fr_auto_auto] gap-x-10 gap-y-4 border-y border-border py-5 text-sm">
          <div class="min-w-0">
            <dt class="text-text-secondary mb-1">{data.paths.length === 1 ? 'Path' : 'Paths'}</dt>
            {data.paths.map((p: string) => (
              <dd class="font-mono text-text-primary break-all">{p}</dd>
            ))}
          </div>
          <div>
            <dt class="text-text-secondary mb-1">Author</dt>
            <dd class="text-text-primary">{data.author}</dd>
          </div>
          <div>
            <dt class="text-text-secondary mb-1">Created</dt>
            <dd class="text-text-primary tabular-nums">{formatDate(data.created)}</dd>
          </div>
        </dl>
      </header>

      <section class="mb-14">
        <h2 class={h2}>
          Example Use Cases
          <span class="ml-1 text-text-secondary font-normal tabular-nums">{useCases.length}</span>
        </h2>
        <div class="divide-y divide-border border-t border-border">
          {useCases.map((uc) => (
            <UseCaseBlock
              id={uc.id}
              name={uc.name}
              description={uc.description}
              code={uc.code}
              tactics={uc.tactics}
              tags={uc.tags}
            />
          ))}
        </div>
      </section>

      <section id="detections" class="mb-14">
        <h2 class={h2}>Detections</h2>
        <ul class="space-y-2">
          {data.detections.map((d: any) => (
            <li class="text-text-secondary">
              {d.url.toLowerCase() === 'n/a' ? (
                <span>{d.name}</span>
              ) : (
                <a href={d.url} class="text-leaf hover:underline underline-offset-2" target="_blank" rel="noopener">{d.name}</a>
              )}
            </li>
          ))}
        </ul>
      </section>

      {data.resources.length > 0 && (
        <section id="resources" class="mb-14">
          <h2 class={h2}>Resources</h2>
          <ul class="space-y-2">
            {data.resources.map((r: any) => (
              <li>
                <a href={r.url} class="text-leaf hover:underline underline-offset-2" target="_blank" rel="noopener">{r.name}</a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {data.acknowledgements.length > 0 && (
        <section id="acknowledgements" class="mb-14">
          <h2 class={h2}>Acknowledgements</h2>
          <ul class="list-disc list-inside text-text-secondary space-y-1">
            {data.acknowledgements.map((a: string) => <li>{a}</li>)}
          </ul>
        </section>
      )}
    </article>

    <aside class="hidden lg:block" data-pagefind-ignore>
      <nav class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto text-sm" aria-label="On this page">
        <div class="text-xs uppercase tracking-wide text-text-secondary mb-3">On this page</div>
        <ul>
          {useCases.map((uc) => (
            <li><a href={`#${uc.id}`} class={tocLink}>{uc.name}</a></li>
          ))}
        </ul>
        <ul class="mt-4">
          {tocSections.map((s) => (
            <li><a href={`#${s.id}`} class={tocLink}>{s.label}</a></li>
          ))}
        </ul>
      </nav>
    </aside>
  </div>
</BaseLayout>

<script>
  // Highlight the table-of-contents entry for the section nearest the top of the viewport.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('aside nav a[href^="#"]')].map((a) => [a.hash.slice(1), a]),
  );
  const targets = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);

  function update() {
    let current = targets[0];
    for (const el of targets) {
      if (el.getBoundingClientRect().top <= 120) current = el;
      else break;
    }
    for (const [id, a] of links) a.setAttribute('aria-current', String(id === current?.id));
  }

  if (targets.length) {
    document.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
