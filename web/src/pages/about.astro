---
import BaseLayout from '../layouts/BaseLayout.astro';

const gh = (repo: string, path: string, branch = 'main') => `https://github.com/${repo}/blob/${branch}/${path}`;

const vendors = [
  {
    name: 'Elastic',
    project: 'Elastic Detection Rules',
    usage: 'macOS detection rules cite LOOBins entries as references.',
    link: gh('elastic/detection-rules', 'rules/macos/credential_access_high_volume_of_pbpaste.toml'),
  },
  {
    name: 'Splunk',
    project: 'Splunk Security Content',
    usage: 'macOS detections and analytic stories reference LOOBins.',
    link: gh('splunk/security_content', 'detections/endpoint/macos_loginhook_persistence.yml', 'develop'),
  },
  {
    name: 'Sumo Logic',
    project: 'Cloud SIEM Content Catalog',
    usage: 'First-seen macOS binary rules are built on LOOBins data.',
    link: gh('SumoLogic/cloud-siem-content-catalog', 'rules/FIRST-S00039.md', 'master'),
  },
  {
    name: 'Red Canary',
    project: 'Atomic Red Team',
    usage: 'macOS atomic tests are sourced from LOOBins entries.',
    link: gh('redcanaryco/atomic-red-team', 'atomics/T1555.001/T1555.001.yaml', 'master'),
  },
  {
    name: 'North Pole Security',
    project: 'Santa',
    usage: 'The CEL policy cookbook references LOOBins.',
    link: gh('northpolesec/santa', 'docs/docs/cookbook/cel.mdx'),
  },
  {
    name: 'Magic Sword',
    project: 'Magic Atomics',
    usage: 'Ingests LOOBins as a data source.',
    link: gh('magicsword-io/Magic-Atomics', 'backend/app/ingestion/loobins.py'),
  },
  {
    name: 'Securonix',
    project: 'Threat Research',
    usage: 'Published detection guidance for LOOBins attack activity.',
    link: 'https://www.securonix.com/blog/detecting-macos-loobins-attack-activity-using-security-analytics/',
  },
];
---

<BaseLayout title="About" description="About the LOOBins project">
  <article class="prose prose-invert max-w-3xl">
    <h1>About LOOBins</h1>
    <p>
      <strong>LOOBins</strong> (Living Off the Orchard: macOS Binaries) is a community-driven project documenting macOS built-in binaries that can be used by threat actors for post-exploitation activities.
    </p>
    <p>
      Inspired by projects like <a href="https://gtfobins.github.io/" target="_blank" rel="noopener">GTFOBins</a> and <a href="https://lolbas-project.github.io/" target="_blank" rel="noopener">LOLBAS</a>, LOOBins focuses specifically on macOS and the unique binaries available in Apple's ecosystem.
    </p>

    <h2>What Makes LOOBins Different?</h2>
    <ul>
      <li>Focuses exclusively on <strong>macOS-specific</strong> binaries</li>
      <li>Maps use cases to <strong>MITRE ATT&CK</strong> tactics</li>
      <li>Includes <strong>detection</strong> guidance for each technique</li>
      <li>Provides a <strong>Python SDK</strong> (<a href="https://pypi.org/project/pyloobins/" target="_blank" rel="noopener">PyLOOBins</a>) for programmatic access</li>
      <li>Exports data in <strong>STIX 2.0</strong> format for threat intelligence platforms</li>
    </ul>

    <h2 id="used-by">Used By</h2>
    <p>
      LOOBins data is referenced in detection content, adversary emulation, and security research across the industry.
      Each entry below links to a public example.
    </p>
    <div class="not-prose grid gap-4 sm:grid-cols-2 my-6">
      {vendors.map((v) => (
        <a
          href={v.link}
          target="_blank"
          rel="noopener"
          class="block bg-surface-light border border-border rounded-lg p-5 hover:border-apple-green transition-colors"
        >
          <div class="text-lg font-semibold text-text-primary">{v.name}</div>
          <div class="text-sm text-apple-green mb-2">{v.project}</div>
          <p class="text-sm text-text-secondary">{v.usage}</p>
        </a>
      ))}
    </div>
    <p>
      Using LOOBins in your product or project?
      <a href="https://github.com/infosecB/LOOBins/issues/new" target="_blank" rel="noopener">Open an issue</a>
      to be added to this list.
    </p>

    <h2>Contributing</h2>
    <p>
      LOOBins is open source and welcomes contributions. If you know of a macOS binary that can be abused by threat actors, please consider submitting a LOOBin entry.
    </p>
    <p>
      See the <a href="https://github.com/infosecB/LOOBins/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener">Contributing Guide</a> for details on how to submit new entries.
    </p>
  </article>
</BaseLayout>
