---
// The per-tag pages were folded into the /binaries/ filters; keep old links working.
import { getCollection } from 'astro:content';
import { filterUrl, loobinTags, slugify } from '../../utils/helpers';

export async function getStaticPaths() {
  const loobins = await getCollection('loobins');
  const tags = new Set(loobins.flatMap(loobinTags));
  return [...tags].map((tag) => ({ params: { tag: slugify(tag) }, props: { tag } }));
}

return Astro.redirect(filterUrl('tag', Astro.props.tag), 301);
---
