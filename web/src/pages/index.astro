---
import BaseLayout from '../layouts/BaseLayout.astro';
import LOOBinCard from '../components/LOOBinCard.astro';
import { getCollection } from 'astro:content';
import { filterUrl, loobinTactics, tacticColor, tacticOrder, url } from '../utils/helpers';

const loobins = await getCollection('loobins');
const useCaseCount = loobins.reduce((sum, l) => sum + l.data.example_use_cases.length, 0);
const recent = [...loobins].sort((a, b) => b.data.created.getTime() - a.data.created.getTime()).slice(0, 6);

// Counted per binary so the numbers match what the /binaries/ tactic filter shows.
const binaryTactics = loobins.map(loobinTactics);
const tactics = tacticOrder
  .map((t) => ({ name: t, count: binaryTactics.filter((list) => list.includes(t)).length }))
  .filter((t) => t.count > 0);
---

<BaseLayout title="Home">
  <section class="max-w-2xl mx-auto text-center pt-10 pb-16 sm:pt-16 sm:pb-20">
    <img src={url('/loobins.png')} alt="" class="w-16 h-16 sm:w-20 sm:h-20 mx-auto mb-6" />
    <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight mb-3">LOOBins</h1>
    <p class="text-lg text-text-primary mb-2">Living Off the Orchard: macOS Binaries</p>
    <p class="text-text-secondary mb-8">
      A curated list of macOS built-in binaries that can be used by threat actors for post-exploitation activities.
    </p>

    <form action={url('/binaries/')} method="get" role="search" class="relative mb-4">
      <label for="home-q" class="sr-only">Search binaries</label>
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-text-secondary pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" />
      </svg>
      <input
        id="home-q"
        name="q"
        type="search"
        placeholder="Search by name, path, or tag…"
        autocomplete="off"
        class="w-full bg-surface-light border border-border rounded-lg pl-12 pr-4 py-3 text-base text-text-primary placeholder:text-text-secondary focus:outline-none focus:border-leaf transition-colors"
      />
    </form>

    <p class="text-sm text-text-secondary">
      <span class="tabular-nums">{loobins.length}</span> binaries
      <span class="mx-1.5" aria-hidden="true">·</span>
      <span class="tabular-nums">{useCaseCount}</span> use cases
      <span class="mx-1.5" aria-hidden="true">·</span>
      <a href={url('/binaries/')} class="text-leaf hover:underline underline-offset-2">Browse all</a>
    </p>
  </section>

  <section class="pb-16">
    <div class="flex items-baseline justify-between mb-5">
      <h2 class="text-xl font-semibold tracking-tight">Recently Added</h2>
      <a href={url('/binaries/?sort=newest')} class="text-sm text-text-secondary hover:text-text-primary transition-colors">View newest &rarr;</a>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {recent.map((loobin) => <LOOBinCard loobin={loobin} />)}
    </div>
  </section>

  <section class="pb-16">
    <h2 class="text-xl font-semibold tracking-tight mb-5">Browse by Tactic</h2>
    <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4">
      {tactics.map((t) => (
        <li>
          <a
            href={filterUrl('tactic', t.name)}
            class="flex items-center gap-2.5 px-4 py-2.5 rounded-lg border border-border bg-surface-light/60 text-sm hover:border-text-secondary/40 hover:bg-surface-light transition-colors"
          >
            <span class={`w-2 h-2 rounded-full ${tacticColor(t.name)}`} aria-hidden="true"></span>
            <span class="flex-1">{t.name}</span>
            <span class="text-text-secondary tabular-nums">{t.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
