---
import { filterUrl, tacticColor } from '../utils/helpers';

interface Props {
  tactic: string;
  linked?: boolean;
}

const { tactic, linked = true } = Astro.props;
const color = tacticColor(tactic);
---

{linked ? (
  <a href={filterUrl('tactic', tactic)} class={`inline-block text-xs px-2 py-0.5 rounded text-white ${color} hover:opacity-80 transition-opacity`}>
    {tactic}
  </a>
) : (
  <span class={`inline-block text-xs px-2 py-0.5 rounded text-white ${color}`}>
    {tactic}
  </span>
)}
