---
import { filterUrl, tacticColor } from '../utils/helpers';

interface Props {
  tactic: string;
  linked?: boolean;
}

const { tactic, linked = true } = Astro.props;
const Tag = linked ? 'a' : 'span';
const cls = 'inline-flex items-center gap-1.5 text-xs px-2 py-0.5 rounded border border-border text-text-primary';
---

<Tag
  href={linked ? filterUrl('tactic', tactic) : undefined}
  class:list={[cls, linked && 'hover:border-text-secondary/60 transition-colors']}
>
  <span class={`w-1.5 h-1.5 rounded-full ${tacticColor(tactic)}`} aria-hidden="true"></span>
  {tactic}
</Tag>
