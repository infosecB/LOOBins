---
import SearchWidget from './SearchWidget.astro';
import { url } from '../utils/helpers';
---

<nav class="bg-surface-light border-b border-border sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href={url('/')} class="flex items-center gap-2 text-xl font-bold text-apple-green hover:opacity-80">
        <img src={url('/loobins.png')} alt="LOOBins" class="h-8 w-8" />
        <span>LOOBins</span>
      </a>

      <div class="hidden md:flex items-center gap-6">
        <a href={url('/binaries/')} class="text-text-secondary hover:text-text-primary transition-colors">Binaries</a>
        <a href={url('/about/')} class="text-text-secondary hover:text-text-primary transition-colors">About</a>
        <a href={url('/loobins.json')} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-text-secondary hover:text-text-primary transition-colors">
          JSON
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5" />
          </svg>
          <span class="sr-only">(opens in a new tab)</span>
        </a>
        <SearchWidget id="pagefind-search-desktop" />
      </div>

      <button id="mobile-menu-btn" class="md:hidden text-text-secondary hover:text-text-primary" aria-label="Toggle menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-border">
    <div class="px-4 py-3 space-y-2">
      <a href={url('/binaries/')} class="block text-text-secondary hover:text-text-primary py-1">Binaries</a>
      <a href={url('/about/')} class="block text-text-secondary hover:text-text-primary py-1">About</a>
      <a href={url('/loobins.json')} target="_blank" rel="noopener" class="flex items-center gap-1 text-text-secondary hover:text-text-primary py-1">
        JSON
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5" />
        </svg>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
      <div class="pt-1">
        <SearchWidget id="pagefind-search-mobile" />
      </div>
    </div>
  </div>
</nav>

<script is:inline>
  document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
